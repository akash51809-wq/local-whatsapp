# Server
PORT=10000
NODE_ENV=production

# MongoDB
MONGO_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE

# Authentication
# Generate a long random value. Used for signing login/session tokens.
AUTH_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# User password settings
# Passwords are NEVER stored in plain text; they are hashed before MongoDB storage.
USER_PASSWORD_LENGTH=10

# OTP settings
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# WhatsApp session storage
# Baileys authentication state will be stored under this directory.
WHATSAPP_SESSION_DIR=./whatsapp_sessions

# Encrypt sensitive WhatsApp session data at rest.
# Generate a strong random 32-byte key and keep it only in environment variables.
WHATSAPP_SESSION_ENCRYPTION_KEY=CHANGE_THIS_TO_A_RANDOM_32_BYTE_KEY

# Existing Admin WhatsApp session
ADMIN_WHATSAPP_SESSION_ID=admin

# Public application URL
APP_URL=http://localhost:10000
