# MongoDB
MONGO_URI=

# App
NODE_ENV=production
PORT=10000
APP_URL=

# Admin login (change in Render Environment Variables)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# Authentication
AUTH_TOKEN_TTL_DAYS=30
USER_PASSWORD_LENGTH=10
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# WhatsApp session storage
# Keep this as ./auth_info if the existing Admin WhatsApp scan is already stored there.
ADMIN_WHATSAPP_SESSION_ID=admin
ADMIN_WHATSAPP_SESSION_DIR=./auth_info

# Future user WhatsApp sessions will use one folder per user under this directory.
WHATSAPP_SESSION_DIR=./whatsapp_sessions
